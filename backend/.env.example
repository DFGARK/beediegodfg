# ─── Base de datos PostgreSQL (Render / Supabase / Railway) ───────────────────
DATABASE_URL=postgresql://usuario:password@host:5432/beehive_rfid

# ─── Autenticación JWT ────────────────────────────────────────────────────────
JWT_SECRET=cambia_este_valor_por_un_string_largo_aleatorio_minimo_32_chars
JWT_EXPIRES_IN=7d

# ─── Clave de API para los lectores ESP32 ────────────────────────────────────
# Debe coincidir exactamente con API_KEY en el firmware .ino
ESP32_API_KEY=beehive_esp32_key_2026

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=4000

# ─── CORS: URL del frontend ───────────────────────────────────────────────────
# En producción: URL de Vercel. Separar por comas si hay varios orígenes.
# Ejemplo producción: https://beediegodfg.vercel.app
# Ejemplo local:      http://localhost:3000
FRONTEND_URL=http://localhost:3000
