# ─── URL del backend desplegado en Render ─────────────────────────────────────
# Sin barra al final. Render asigna: https://<nombre-del-servicio>.onrender.com
NEXT_PUBLIC_API_URL=https://tu-backend.onrender.com/api/v1

# ─── URL base para Socket.IO (misma que el backend, sin /api/v1) ──────────────
NEXT_PUBLIC_SOCKET_URL=https://tu-backend.onrender.com
